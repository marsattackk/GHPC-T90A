<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>T90A</AssemblyName>
    <RootNamespace>T90A</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gunner HEAT PC\Bin</GameDir>
    <NoWarn>$(NoWarn);MSB3277;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\T72M1_skin_hull_trimmed.bin" LogicalName="T72M1_skin_hull_trimmed.bin" />
    <EmbeddedResource Include="Resources\round_3bm42_co.png" LogicalName="round_3bm42_co.png" />
    <EmbeddedResource Include="Resources\round_3bm60_co.png" LogicalName="round_3bm60_co.png" />
    <EmbeddedResource Include="Resources\round_9m119m_co.png" LogicalName="round_9m119m_co.png" />
    <EmbeddedResource Include="Resources\round_meshes.txt" LogicalName="round_meshes.txt" />
    <EmbeddedResource Include="Resources\round_mesh_3bm60_charge.mesh" LogicalName="round_mesh_3bm60_charge.mesh" />
    <EmbeddedResource Include="Resources\round_mesh_3bm60_oring.mesh" LogicalName="round_mesh_3bm60_oring.mesh" />
    <EmbeddedResource Include="Resources\round_mesh_3bm60_rod.mesh" LogicalName="round_mesh_3bm60_rod.mesh" />
    <EmbeddedResource Include="Resources\round_mesh_3bm60_sabot_001.mesh" LogicalName="round_mesh_3bm60_sabot_001.mesh" />
    <EmbeddedResource Include="Resources\round_mesh_3bm60_sabot_003.mesh" LogicalName="round_mesh_3bm60_sabot_003.mesh" />
    <EmbeddedResource Include="Resources\round_mesh_3bm60_sabot_004.mesh" LogicalName="round_mesh_3bm60_sabot_004.mesh" />
    <EmbeddedResource Include="Resources\round_mesh_9m119m_missile.mesh" LogicalName="round_mesh_9m119m_missile.mesh" />
    <EmbeddedResource Include="Resources\round_mesh_9x949_charge.mesh" LogicalName="round_mesh_9x949_charge.mesh" />
    <EmbeddedResource Include="Resources\tkn4s_day.jsonc" LogicalName="tkn4s_day.jsonc" />
    <EmbeddedResource Include="Resources\tkn4s_night.jsonc" LogicalName="tkn4s_night.jsonc" />
    <EmbeddedResource Include="Resources\essa_monitor.jsonc" LogicalName="essa_monitor.jsonc" />
    <EmbeddedResource Include="Resources\modules_built.json" LogicalName="modules_built.json" />
    <EmbeddedResource Include="Resources\interior_map.txt" LogicalName="interior_map.txt" />
    <EmbeddedResource Include="Resources\gun_depression.txt" LogicalName="gun_depression.txt" />
    <EmbeddedResource Include="Resources\shtora_panel.png" LogicalName="shtora_panel.png" />
    <EmbeddedResource Include="Resources\shtora_lamp_off.png" LogicalName="shtora_lamp_off.png" />
    <EmbeddedResource Include="Resources\shtora_lamp_on.png" LogicalName="shtora_lamp_on.png" />
    <EmbeddedResource Include="Resources\shtora_layout.txt" LogicalName="shtora_layout.txt" />
    <EmbeddedResource Include="Resources\shtora_alarm.wav" LogicalName="shtora_alarm.wav" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(GameDir)\MelonLoader\net35\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\MelonLoader\net35\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\GHPC_Data\Managed\*.dll" Exclude="$(GameDir)\GHPC_Data\Managed\mscorlib.dll;$(GameDir)\GHPC_Data\Managed\netstandard.dll;$(GameDir)\GHPC_Data\Managed\System*.dll;$(GameDir)\GHPC_Data\Managed\Mono*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

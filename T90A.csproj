<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>T90A</AssemblyName>
    <RootNamespace>T90A</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gunner HEAT PC\Bin</GameDir>
    <NoWarn>$(NoWarn);MSB3277;CS0618</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>   <!-- its own project -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything in Resources\ under its plain file name, which is the name the code asks for. -->
    <EmbeddedResource Include="Resources\*" Exclude="Resources\README.md" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(GameDir)\MelonLoader\net35\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\MelonLoader\net35\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\GHPC_Data\Managed\*.dll" Exclude="$(GameDir)\GHPC_Data\Managed\mscorlib.dll;$(GameDir)\GHPC_Data\Managed\netstandard.dll;$(GameDir)\GHPC_Data\Managed\System*.dll;$(GameDir)\GHPC_Data\Managed\Mono*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Without the game the build would fail with hundreds of missing-type errors: stop first and say what to pass. -->
  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDir)\GHPC_Data\Managed\Assembly-CSharp.dll')"
           Text="Gunner, HEAT, PC! not found in GameDir '$(GameDir)'. Build with -p:GameDir=&quot;&lt;the game's Bin folder&gt;&quot;, the folder that holds GHPC_Data and MelonLoader." />
    <Error Condition="!Exists('$(GameDir)\MelonLoader\net35\MelonLoader.dll')"
           Text="MelonLoader not found in GameDir '$(GameDir)'. Install MelonLoader into the game, or pass -p:GameDir=&quot;&lt;the game's Bin folder&gt;&quot;." />
  </Target>

  <!-- The version stamp the DLL logs on load (BuildStamp.targets). Pass -p:GitCommit=<hash> or the commit shows as "unknown". -->
  <PropertyGroup>
    <BuildFlavour Condition="'$(BuildFlavour)' == ''">public</BuildFlavour>
    <StampAskGit>false</StampAskGit>
  </PropertyGroup>
  <Import Project="BuildStamp.targets" Condition="Exists('BuildStamp.targets')" />

</Project>
